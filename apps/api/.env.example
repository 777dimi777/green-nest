NODE_ENV=development
# Local development values. Replace every value in the hosting dashboard for production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/greennest?schema=public"
JWT_SECRET="replace-with-a-long-random-access-token-secret-at-least-32-characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-random-refresh-secret-at-least-32-characters"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
# Comma-separated exact frontend origins, without paths or trailing slashes.
CORS_ORIGIN="http://localhost:3000"
# Set to false in production unless API documentation is intentionally public.
SWAGGER_ENABLED=true

# Required only when intentionally running the seed with NODE_ENV=production.
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=
