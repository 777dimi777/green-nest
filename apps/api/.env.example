# PostgreSQL (matches the repository docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/greennest?schema=public"

# Use long, random and different secrets outside development
JWT_SECRET="replace-with-a-long-random-access-token-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-token-secret"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001

# Comma-separated origins are supported
CORS_ORIGIN="http://localhost:3000"
